# Copy to .env and fill in. Never commit .env.

# Local dev (default): SQLite file in backend/
DATABASE_URL=sqlite:///./scioly.db

# Production (Supabase): use the transaction pooler connection string from
# Supabase dashboard -> Connect -> "Transaction pooler" (port 6543), with the psycopg driver:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Shared tournament PIN graders type on first login
TOURNAMENT_PIN=change-me

# Where scan images are stored in dev
UPLOAD_DIR=./data/uploads
