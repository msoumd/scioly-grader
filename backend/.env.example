# Copy to .env and fill in. Never commit .env.

# Local dev (default): SQLite file in backend/
DATABASE_URL=sqlite:///./scioly.db

# Production (Supabase): use the transaction pooler connection string from
# Supabase dashboard -> Connect -> "Transaction pooler" (port 6543), with the psycopg driver:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Shared tournament PIN graders type on first login
TOURNAMENT_PIN=change-me

# Where scan images are stored in dev
UPLOAD_DIR=./data/uploads

# Admin PIN for supervisor actions (import events/teams, resolve duplicates, re-score)
ADMIN_PIN=change-me-too

# Signs login cookies. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-string

# Plain-http local dev only: allow the login cookie without HTTPS
# COOKIE_SECURE=false

# Allowed browser origins for the frontend, comma separated
# CORS_ORIGINS=http://localhost:5173
# Built phone app served at "/": empty = ../frontend/dist if built, "off" = API only.
# FRONTEND_DIST=

# Image storage: "local" (UPLOAD_DIR) or "supabase" (private bucket, server-side key only)
STORAGE_BACKEND=local
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   # never commit; set in the host's secret settings
# SUPABASE_BUCKET=scans
